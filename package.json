{
  "name": "fitcard-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --test tests/core.test.mjs",
    "test:db": "node tests/database.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:live": "node --env-file-if-exists=.env.local tests/live-smoke.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@supabase/supabase-js": "2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@11.25.0"
}
